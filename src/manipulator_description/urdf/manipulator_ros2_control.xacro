<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="manipulator">

    <!--
        WHAT hardware you have
        WHAT joints you want to control
        HOW those joints receive commands (position, effort, velocity)
        WHAT limits they have
        WHICH joints mimic others
    -->

    <xacro:property name="PI" value="3.14159265359" />

    <!-- This <ros2_control> block configures the hardware/system plugin for ros2_control -->
    <ros2_control type="system" name="RobotSystem">

        <xacro:if value="${is_sim}">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <!-- joint_5 mimics joint_4 with multiplier=-1 in the URDF -->
            <joint name="joint_5">
                <param name="mimic">joint_4</param>
                <param name="multiplier">-1</param>
                <state_interface name="position"/>
            </joint>
        </xacro:if>

        <xacro:unless value="${is_sim}">
            <hardware>
                <plugin>manipulator_controller/ManipulatorInterfaceSTS3215</plugin>
                <!-- STS3215 setup via external serial bridge/controller -->
                <param name="port">/dev/ttyACM0</param> <!-- USB device where the URT‑2 adapter shows up. -->
                <param name="baudrate">1000000</param>  <!--serial speed for the bus (1Mbps for STS3215)-->
                <param name="servo_ids">1,2,3</param>
                <param name="gpio_gripper">22</param>

                <!-- STS3215 register map (override if your firmware differs) -->
                <param name="goal_position_addr">0x2A</param> <!-- register address to write a target position. -->
                <param name="present_position_addr">0x38</param>  <!-- register address to read the actual position (feedback). -->

                <!-- Raw encoder range for STS3215 position -->
                <param name="position_raw_min">0</param> 
                <param name="position_raw_max">4095</param>

                <!-- Servo angle range that maps to raw min/max -->
                <param name="position_rad_min">-1.57</param>
                <param name="position_rad_max">1.57</param>

                <!-- Default STS3215 motion profile -->
                <param name="servo_speed">1000</param>
                <param name="servo_acceleration">50</param>

                <!-- STS3215 tuning defaults -->
                <param name="tuning_enable">true</param>
                <param name="position_p_gain">28</param>
                <param name="position_d_gain">24</param>
                <param name="position_i_gain">0</param>
                <param name="deadband_cw">3</param>
                <param name="deadband_ccw">3</param>
                <param name="punch">16</param>

                <!-- Set true when firmware publishes measured servo position feedback -->
                <param name="feedback_from_hardware">true</param>
            </hardware>
        </xacro:unless>



        <!-- joint_1 (razor_connector -> motor_2) : URDF limits [-3.14, 3.14] -->
        <joint name="joint_1">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <!-- joint_2 (motor_2 -> h_arm_L) : URDF limits [-1.57, 1.57] -->
        <joint name="joint_2">
            <command_interface name="position">
                <param name="min">-0.79</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <!-- joint_3 (h_arm -> motor_3) : URDF limits [-1.57, 1.57] -->
        <joint name="joint_3">
            <command_interface name="position">
                <param name="min">-0.79</param>
                <param name="max">0.79</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <!-- joint_4 (gripper_L) : URDF limits [0, 1.2] -->
        <joint name="joint_4">
            <command_interface name="position">
                <param name="min">0.0</param>
                <param name="max">0.79</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>


    </ros2_control>

</robot>